      "rule": [
        {
          "code": "90201",
          "message": "catalog_entity_code is write-once: it cannot be changed once set",
          "source_module": "platform",
          "jsonlogic": {
            "if": [
              {
                "value_changed": "catalog_entity_code"
              },
              {
                "or": [
