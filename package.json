{
  "name": "semantius-app",
  "private": true,
  "version": "0.1.0",
  "description": "web ui for semantius",
  "scripts": {
    "dev": "dotenvx run -- turbo dev",
    "dev:supabase": "dotenvx run --env-file .env.supabase -- turbo dev:supabase",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "dotenvx run -- turbo test",
    "preview": "dotenvx run -- turbo preview",
    "preview:wrangler": "dotenvx run -- turbo preview:wrangler",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.3.6"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.6.0",
      "@lezer/common": "1.5.2"
    }
  }
}