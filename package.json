{
  "name": "semantius-app",
  "private": true,
  "version": "0.3.13",
  "description": "web ui for semantius",
  "scripts": {
    "dev": "dotenvx run -- turbo dev",
    "dev:supabase": "dotenvx run --env-file .env.supabase -- turbo dev:supabase",
    "build": "turbo build",
    "lint": "turbo lint",
    "i18n:extract": "node apps/web/scripts/i18n/extract.mjs",
    "i18n:status": "node apps/web/scripts/i18n/status.mjs",
    "i18n:translate": "dotenvx run -- node apps/web/scripts/i18n/translate.mjs",
    "i18n:import": "dotenvx run -- node apps/web/scripts/i18n/import.mjs",
    "check": "pnpm --filter @semantius/frontend lint && dotenvx run -- pnpm --filter @semantius/frontend test && pnpm --filter sem-schema test",
    "test:browser": "dotenvx run -- pnpm --filter @semantius/frontend exec vitest run --project browser",
    "test:e2e": "pnpm --filter @semantius/frontend test:e2e",
    "test:a11y-audit": "dotenvx run -- node scripts/a11y-audit/run.mjs",
    "test": "dotenvx run -- turbo test",
    "preview": "dotenvx run -- turbo preview",
    "preview:wrangler": "dotenvx run -- turbo preview:wrangler",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.6.0",
      "@lezer/common": "1.5.2",
      "proxy-addr@<2.0.8": "^2.0.8",
      "handlebars@<4.7.10": "^4.7.10",
      "undici@>=7 <7.30.1": "^7.30.1",
      "brace-expansion@>=1 <1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "source-map-js@<1.2.2": "^1.2.2",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "zod@>=4 <4.6.6": "^4.6.6",
      "body-parser@>=2 <2.4.0": "^2.4.0",
      "systeminformation@<5.33.16": "^5.33.16",
      "fast-uri@<3.1.9": "^3.1.9",
      "ip-address@<10.7.4": "^10.7.4",
      "hono@<4.13.16": "^4.13.16",
      "@hono/node-server@<2.1.6": "^2.1.6",
      "qs@<6.16.1": "^6.16.1",
      "postcss-selector-parser@>=7 <7.1.6": "^7.1.6",
      "glob@>=9 <14.0.2": "^14.0.2",
      "minimatch@>=7 <11.0.1": "^11.0.1"
    },
    "patchedDependencies": {
      "shadcn": "patches/shadcn.patch"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
