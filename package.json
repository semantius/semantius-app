{
  "name": "semantius-app",
  "private": true,
  "version": "0.2.7",
  "description": "web ui for semantius",
  "scripts": {
    "dev": "dotenvx run -- turbo dev",
    "dev:supabase": "dotenvx run --env-file .env.supabase -- turbo dev:supabase",
    "build": "turbo build",
    "lint": "turbo lint",
    "i18n:extract": "node apps/web/scripts/i18n/extract.mjs",
    "i18n:status": "node apps/web/scripts/i18n/status.mjs",
    "i18n:translate": "dotenvx run -- node apps/web/scripts/i18n/translate.mjs",
    "i18n:import": "dotenvx run -- node apps/web/scripts/i18n/import.mjs",
    "check": "pnpm --filter @semantius/frontend lint && dotenvx run -- pnpm --filter @semantius/frontend test",
    "test:browser": "dotenvx run -- pnpm --filter @semantius/frontend exec vitest run --project browser",
    "test:e2e": "pnpm --filter @semantius/frontend test:e2e",
    "test:a11y-audit": "dotenvx run -- node scripts/a11y-audit/run.mjs",
    "test": "dotenvx run -- turbo test",
    "preview": "dotenvx run -- turbo preview",
    "preview:wrangler": "dotenvx run -- turbo preview:wrangler",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.6.0",
      "@lezer/common": "1.5.2"
    }
  }
}
