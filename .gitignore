# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
# The tenant e2e build (playwright.config.ts) writes here so the two e2e builds
# do not clobber each other.
dist-e2e-tenant
dist-ssr
*.local
.turbo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.dist
.env.keys
.env.*
!.env.sample
!.env.example

# Docker runtime config holds real values — commit only the .env.example file.
# Bare-name .env needs its own rule: the .env.* pattern above does not match it.
docker/.env

# Workplace version tracking
.workplace-version

# Playwright / TanStack Router build artifacts
playwright-report
test-results
.tanstack

# Incremental typecheck state — regenerated by `tsc -b` on every build.
*.tsbuildinfo

# The a11y audit writes a byte-identical copy of its newest run here; cite runs
# by their timestamped filename instead (see a11y-reports/README.md).
a11y-reports/latest.json

# The audit's --screenshots output: one PNG per cell, regenerated on every run and
# uploaded as a CI artifact. Cite a run by its JSON; the pictures are not a record.
a11y-reports/screenshots/
